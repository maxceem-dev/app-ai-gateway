{
  "name": "app-ai-gateway",
  "version": "0.11.1",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @app-ai-gateway/console dev",
    "console:build": "pnpm --filter @app-ai-gateway/console build",
    "console:typecheck": "pnpm --filter @app-ai-gateway/console typecheck",
    "deploy": "pnpm run console:build && node scripts/deploy.mjs",
    "typecheck": "pnpm run typecheck:worker && pnpm run typecheck:bindings && pnpm run console:typecheck && pnpm run docs:typecheck",
    "check": "node scripts/check.mjs check",
    "test": "node scripts/check.mjs test",
    "verify": "node scripts/check.mjs verify",
    "test:watch": "vitest",
    "openapi:generate": "node --experimental-strip-types scripts/generate-openapi.ts",
    "openapi:check": "node scripts/check-openapi.mjs",
    "suites:check": "node scripts/check-suites.mjs",
    "docs:dev": "pnpm --filter @app-ai-gateway/docs dev",
    "docs:build": "pnpm --filter @app-ai-gateway/docs build",
    "docs:deploy": "pnpm --filter @app-ai-gateway/docs static:build && node scripts/wrangler.mjs --cwd docs deploy",
    "docs:typecheck": "pnpm --filter @app-ai-gateway/docs typecheck",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "node scripts/wrangler.mjs d1 migrations apply DB --remote",
    "secrets:upload": "node scripts/upload-local-secrets.mjs",
    "secrets:setup-local": "node scripts/setup-local-secrets.mjs",
    "recover-access": "node scripts/recover-access.mjs",
    "deploy:dry-run": "pnpm run console:build && node scripts/wrangler.mjs deploy --dry-run",
    "startup:check": "wrangler check startup",
    "console:test": "pnpm --filter @app-ai-gateway/console test",
    "console:ensure": "node -e \"require('node:fs').mkdirSync('console/dist',{recursive:true})\"",
    "typecheck:worker": "tsgo --noEmit",
    "typecheck:bindings": "wrangler types --check --env-file .dev.vars.example",
    "typecheck:tsc": "tsc --noEmit && pnpm --filter @maxceem/agw typecheck:tsc && pnpm --filter @app-ai-gateway/console typecheck:tsc && pnpm --filter @app-ai-gateway/docs typecheck:tsc",
    "test:worker": "vitest run --config vitest.suites.config.ts",
    "test:swift-publish": "node --test test/swift-publish.node.mjs",
    "test:deploy-script": "node --test test/deploy-script.node.mjs",
    "test:release-script": "node --test test/release-script.node.mjs",
    "test:indexnow": "node --test test/indexnow.node.mjs",
    "test:update-models": "node --test test/update-models.node.mjs test/review-models.node.mjs",
    "pretest:worker": "pnpm run console:ensure",
    "cli:build": "pnpm --filter @maxceem/agw build",
    "cli:dev": "node cli/scripts/dev.mjs",
    "cli:dev:reset": "node cli/scripts/dev.mjs --reset",
    "cli:check": "pnpm --filter @maxceem/agw check",
    "cli:test": "pnpm --filter @maxceem/agw test",
    "cli:release:github": "node cli/scripts/publish-release.mjs",
    "smoke": "pnpm --filter @app-ai-gateway/smoke smoke",
    "smoke:setup": "pnpm --filter @app-ai-gateway/smoke run setup",
    "smoke:mock": "pnpm --filter @app-ai-gateway/smoke run mock",
    "smoke:check": "pnpm --filter @app-ai-gateway/smoke check",
    "smoke:test": "pnpm --filter @app-ai-gateway/smoke test",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.9",
    "@hono/zod-openapi": "^1.5.1",
    "@maxceem/cf-auth": "https://github.com/maxceem/cf-auth/releases/download/v0.10.0/maxceem-cf-auth-0.10.0.tgz",
    "@maxceem/cf-kms": "https://github.com/maxceem/cf-kms/releases/download/v0.1.0/maxceem-cf-kms-0.1.0.tgz",
    "@maxceem/worker-mailer": "https://github.com/maxceem/worker-mailer/releases/download/v1.4.3/maxceem-worker-mailer-1.4.3.tgz",
    "@modelcontextprotocol/server": "2.2.0",
    "asn1js": "^3.0.7",
    "better-auth": "1.6.9",
    "cbor-x": "^1.6.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.0",
    "jose": "^6.0.0",
    "pkijs": "^3.3.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.7",
    "@cloudflare/workers-types": "^5.20260723.1",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "drizzle-kit": "^0.31.10",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "cloudflare": {
    "bindings": {
      "SECRET_VAULT_LOCAL_KEK_V1": {
        "description": "Generate a unique local vault key with `openssl rand -base64 32`. It encrypts provider credentials at rest and must be backed up securely."
      },
      "SECRET_VAULT_MODE": {
        "description": "Leave this as `local` to encrypt provider credentials inside the Worker under the key above. `kms` instead routes them through a separate [cf-kms](https://github.com/maxceem/cf-kms) deployment and needs its own URL and token."
      },
      "SECRET_VAULT_LOCAL_KEK_CURRENT_VERSION": {
        "description": "Which local vault key new credentials are encrypted under. Leave this as `1`; it only changes when you rotate to a second key."
      },
      "ALLOWED_REGISTRATION_EMAILS": {
        "description": "Your email address. Only the emails listed here, comma-separated, can create an account on this deployment, each one of their own."
      }
    }
  }
}
