{
  "name": "@app-ai-gateway/smoke",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Smoke tests that run against a live App AI Gateway deployment",
  "scripts": {
    "smoke": "vitest run",
    "setup": "node src/setup.ts",
    "account": "node src/account.ts",
    "keygen": "node src/keygen.ts",
    "mock": "node src/mock/server.ts",
    "check": "tsgo --noEmit -p .",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "jose": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
